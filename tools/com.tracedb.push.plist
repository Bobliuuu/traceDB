<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>com.tracedb.push</string>
 <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__HOME__/.local/share/tracedb/mac_push.py</string></array>
 <key>StartInterval</key><integer>1200</integer>
 <key>RunAtLoad</key><true/>
 <key>Nice</key><integer>15</integer>
 <key>LowPriorityIO</key><true/>
 <key>LowPriorityBackgroundIO</key><true/>
 <key>ProcessType</key><string>Background</string>
 <key>StandardOutPath</key><string>__HOME__/.cache/tracedb-push/launchd.out</string>
 <key>StandardErrorPath</key><string>__HOME__/.cache/tracedb-push/launchd.out</string>
</dict></plist>
